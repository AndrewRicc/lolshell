{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoL client",
  "version": "0.1.0",
  "identifier": "dev.lolclient.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "LoL client", "width": 1280, "height": 720, "resizable": false, "maximizable": false, "decorations": false, "alwaysOnTop": false, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
